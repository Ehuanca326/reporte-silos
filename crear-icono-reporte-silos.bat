@echo off
chcp 65001 >nul
setlocal
title Reporte de almacenamiento de silos - crear icono
set "DEST=%LOCALAPPDATA%\ReporteSilos"
if not exist "%DEST%" mkdir "%DEST%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText('%~f0'); $i=$t.LastIndexOf('::ICONO_BASE64::'); $b=$t.Substring($i+16).Trim(); [IO.File]::WriteAllBytes('%DEST%\silo.ico',[Convert]::FromBase64String($b))"
if errorlevel 1 goto error
for /f "usebackq delims=" %%D in (`powershell -NoProfile -Command "[Console]::OutputEncoding=[Text.Encoding]::UTF8; [Environment]::GetFolderPath('Desktop')"`) do set "DESK=%%D"
if not defined DESK set "DESK=%USERPROFILE%\Desktop"
(
echo [InternetShortcut]
echo URL=https://claude.ai/artifact/Pg3VxoMhYUU8H6nA3eGDzm
echo IconIndex=0
echo IconFile=%DEST%\silo.ico
) > "%DESK%\Reporte de silos.url"
if errorlevel 1 goto error
echo.
echo  Listo. En tu escritorio ya esta el icono "Reporte de silos".
echo  Si el dibujo del silo no aparece enseguida, pulsa F5 sobre el escritorio.
echo.
pause
exit /b 0
:error
echo.
echo  No se pudo crear el icono. Avisa a quien te envio este archivo.
pause
exit /b 1
::ICONO_BASE64::

